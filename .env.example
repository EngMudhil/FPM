# Database (Docker Compose maps host 5433 → container 5432)
DATABASE_URL=postgresql://fpm:fpm_dev_password@127.0.0.1:5433/fpm_dev

# Auth (min 32 characters) — generate a unique secret for each environment
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Redis (future workers)
REDIS_URL=redis://localhost:6379

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional session TTL (seconds). Default: 7200 (2 hours)
# SESSION_MAX_AGE_SECONDS=7200

# Node
NODE_ENV=development
