# Production placeholders — copy to .env.production on the VPS (never commit secrets)
POSTGRES_USER=fpm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fpm
DATABASE_URL=postgresql://fpm:change-me-strong-password@postgres:5432/fpm
AUTH_SECRET=replace-with-32-plus-char-random-secret
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_APP_URL=https://fpm.example.com
CERTIFICATE_STORAGE_PATH=/data/certificates
CADDY_ACME_EMAIL=ops@example.com
FPM_DOMAIN=fpm.example.com
NODE_ENV=production
